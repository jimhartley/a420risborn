---
layout: base.njk
---
{% set stage = stage | stageBySlug %}
<article class="post">
  <header>
    <a class="pill pill--{{ stage.status }}" href="/stages/{{ stage.slug }}/">{{ stage.name }}</a>
    <h1>{{ title }}</h1>
    <p class="meta">
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      {% if cost %} · {{ cost | money }}{% endif %}
    </p>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
</article>

{% set idx = -1 %}
{% for p in collections.posts %}{% if p.url == page.url %}{% set idx = loop.index0 %}{% endif %}{% endfor %}
<nav class="pager">
  {% if idx > 0 %}{% set prev = collections.posts[idx - 1] %}<a href="{{ prev.url }}">← {{ prev.data.title }}</a>{% else %}<span></span>{% endif %}
  {% if idx < collections.posts.length - 1 %}{% set next = collections.posts[idx + 1] %}<a href="{{ next.url }}">{{ next.data.title }} →</a>{% endif %}
</nav>
